-- =====================================================================
-- Permite que alunos atualizem e excluam suas próprias justificativas
-- quando forem recusadas ou solicitadas para correção.
-- =====================================================================

GRANT DELETE ON public.justifications TO authenticated;

-- Permite ao aluno editar apenas suas próprias justificativas
DROP POLICY IF EXISTS "Students update own justifications" ON public.justifications;
CREATE POLICY "Students update own justifications" ON public.justifications
  FOR UPDATE TO authenticated
  USING (auth.uid() = student_id)
  WITH CHECK (auth.uid() = student_id);

-- Permite ao aluno excluir apenas suas próprias justificativas
DROP POLICY IF EXISTS "Students delete own justifications" ON public.justifications;
CREATE POLICY "Students delete own justifications" ON public.justifications
  FOR DELETE TO authenticated
  USING (auth.uid() = student_id);

-- Permite ao aluno remover arquivos da sua pasta no bucket 'justificativas'
DROP POLICY IF EXISTS "Users delete own documents" ON storage.objects;
CREATE POLICY "Users delete own documents" ON storage.objects
  FOR DELETE TO authenticated
  USING (bucket_id = 'justificativas' AND (storage.foldername(name))[1] = auth.uid()::text);

-- Permite ao aluno atualizar/substituir arquivos da sua pasta no bucket 'justificativas'
DROP POLICY IF EXISTS "Users update own documents" ON storage.objects;
CREATE POLICY "Users update own documents" ON storage.objects
  FOR UPDATE TO authenticated
  USING (bucket_id = 'justificativas' AND (storage.foldername(name))[1] = auth.uid()::text);
