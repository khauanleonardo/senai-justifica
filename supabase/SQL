-- 3. Cria os perfis nas tabelas do sistema (profiles)
INSERT INTO public.profiles (id, full_name, email)
SELECT id, 
       CASE 
         WHEN email = 'khauan@aluno.senai.br' THEN 'Khauan Aluno'
         WHEN email = 'alan@senai.br' THEN 'Alan Professor'
         ELSE 'Secretaria SENAI'
       END,
       email
FROM auth.users
WHERE email IN ('khauan@aluno.senai.br', 'alan@senai.br', 'secretaria@senai.br')
ON CONFLICT (id) DO NOTHING;

-- 4. Define os privilégios (Aluno, Professor e Secretaria)
INSERT INTO public.user_roles (user_id, role)
SELECT id,
       CASE 
         WHEN email = 'khauan@aluno.senai.br' THEN 'student'
         WHEN email = 'alan@senai.br' THEN 'teacher'
         ELSE 'secretary'
       END
FROM auth.users
WHERE email IN ('khauan@aluno.senai.br', 'alan@senai.br', 'secretaria@senai.br')
ON CONFLICT DO NOTHING;